extern "C" %{
/*
 * Copyright (c) 2026      The University of Tennessee and The University
 *                         of Tennessee Research Foundation.  All rights
 *                         reserved.
 */

/*
 * A task class with no data input (here a WRITE flow and a CTL input) that
 * gets its control input from a task on another rank.
 *
 * The rank that receives the activation asks the class of the successor for
 * the datatype of the input flow, to learn whether data follows the
 * activation. For a control flow the answer must be "nothing". The question
 * carries the index of the flow, while the outputs of the same class answer
 * to masks of dependency indexes: PREP is built so that the two overlap. Its
 * control flow X has index 1 (0x2) and its only data flow T has two output
 * dependencies (0x3). If the question about X ever reaches the outputs, the
 * receiver takes the control for a tile and asks the sender for data that
 * was never sent.
 *
 * GATE(0) and every USE run on rank 0, PREP(k) on rank k modulo the number of
 * ranks. Rank 0 thus waits for the tiles of the other ranks, and is there to
 * answer whatever they ask.
 */
#include "parsec/data_dist/matrix/two_dim_rectangle_cyclic.h"
#include "tests/tests_runtime.h"

static int32_t nb_used = 0;  /* USE tasks (all on rank 0) that read the right value */

%}

descA      [type = "parsec_data_collection_t*"]
NT         [type = int]

GATE(g)
  g = 0 .. 0

: descA(0, 0)

  CTL X -> X PREP(0 .. NT-1)

BODY
END

PREP(k)
  k = 0 .. NT-1

: descA(k, 0)

  WRITE T -> T USE(k, 0)
          -> T USE(k, 1)
  CTL   X <- X GATE(0)

BODY
  *(int*)T = k + 1;
END

USE(k, s)
  k = 0 .. NT-1
  s = 0 .. 1

: descA(0, 0)

  READ T <- T PREP(k)

BODY
  if( (k + 1) == *(int*)T )
      (void)parsec_atomic_fetch_inc_int32(&nb_used);
END

extern "C" %{

int main(int argc, char* argv[])
{
    parsec_ctl_into_write_only_taskpool_t* tp;
    parsec_matrix_block_cyclic_t descA;
    parsec_context_t *parsec;
    int rank = 0, np = 1, nt, rc, i;

    int pargc = 0; char **pargv = NULL;
    for( i = 1; i < argc; i++ ) {
        if( 0 == strncmp(argv[i], "--", 3) ) {
            pargc = argc - i;
            pargv = argv + i;
            break;
        }
    }

    rc = parsec_tests_context_init(-1, PARSEC_TEST_THREAD_SERIALIZED,
                                   &pargc, &pargv,
                                   &parsec, &rank, &np);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_init");

    /* Two PREP per rank. The collection is only used to place the tasks:
     * row k is on rank k modulo np. */
    nt = 2 * np;
    parsec_matrix_block_cyclic_init( &descA, PARSEC_MATRIX_INTEGER, PARSEC_MATRIX_TILE,
                                     rank,
                                     1, 1, nt, 1,
                                     0, 0, nt, 1,
                                     np, 1, 1, 1, 0, 0);

    tp = parsec_ctl_into_write_only_new( (parsec_data_collection_t*)&descA, nt );
    assert( NULL != tp );

    parsec_arena_datatype_set_type( &tp->arenas_datatypes[PARSEC_ctl_into_write_only_DEFAULT_ADT_IDX],
                                    sizeof(int), PARSEC_ARENA_ALIGNMENT_SSE,
                                    parsec_datatype_int_t );

    rc = parsec_context_add_taskpool( parsec, (parsec_taskpool_t*)tp );
    PARSEC_CHECK_ERROR(rc, "parsec_context_add_taskpool");

    rc = parsec_context_start(parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_context_start");

    rc = parsec_context_wait(parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_context_wait");

    PARSEC_OBJ_DESTRUCT(&tp->arenas_datatypes[PARSEC_ctl_into_write_only_DEFAULT_ADT_IDX]);
    parsec_taskpool_free((parsec_taskpool_t*)tp);
    parsec_tiled_matrix_destroy((parsec_tiled_matrix_t*)&descA);

    rc = parsec_tests_context_fini(&parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_fini");

    if( 0 == rank ) {
        if( nb_used != 2 * nt ) {
            printf("TEST FAILED: %d of the %d USE tasks read the value of their PREP\n", nb_used, 2 * nt);
            return 1;
        }
        printf("TEST SUCCESS: the %d USE tasks read the value of their PREP\n", nb_used);
    }
    return 0;
}

%}

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include "parsec/data_dist/matrix/two_dim_rectangle_cyclic.h"
#include "parsec/sys/atomic.h"
#include "tests/tests_runtime.h"

/**
 * A task can wait for the controls of a set of tasks written as a named range
 * at the dependency, "CTL X <- [ k = 0 .. N-1 ] guard ? X T(k)". When the
 * first control arrives the runtime counts how many the task waits for
 * (parsec_check_IN_dependencies_with_counter), in one of two ways:
 *  - A guard that is an integer constant is the same for every k. The count
 *    comes from a function generated for the dependency (ctl_gather_nb), which
 *    used to read k instead of iterating over the range: one control per
 *    dependency.
 *  - Any other guard (a variable, an operator, inline code) is evaluated for
 *    each k. The runtime counts with the function that iterates over the
 *    predecessors of the task, which selects the input dependencies by their
 *    index. The runtime used to pass the index of the flow: with the flow at
 *    index 0, each such dependency counted the tasks of the first one.
 * A ternary, "[ k = 0 .. N-1 ] guard ? X A(k) : X B(k)", is one dependency
 * with two branches, which share its index. Its guard holds the range, so the
 * iterator counts the predecessors of both branches. The runtime used to count
 * the false branch again, with its own count function.
 * A task with a count that is too small starts before the tasks it waits for
 * are done, and again each time the count is reached. With a count that is
 * too large it never starts, and the test does not end.
 *
 * LOW(0 .. NL-1) and HIGH(0 .. NH-1) are two sets of tasks of different sizes,
 * spread over the processes. Five tasks wait for them, each on another
 * process when there are enough: WAIT_CST(0) with constant guards, WAIT_IDX(0)
 * with guards that select every other task of each set, WAIT_MIX(0) with one
 * guard of each kind, and WAIT_TERN(0) and WAIT_TERN(1) with a ternary that
 * takes the first NL tasks of LOW for one and of HIGH for the other. Each must
 * run once, after the tasks it waits for.
 */

enum { W_CST = 0, W_IDX, W_MIX, W_TERN, W_NB = W_TERN + 2 };
static const char *wait_name[W_NB] = { "WAIT_CST(0)", "WAIT_IDX(0)", "WAIT_MIX(0)",
                                       "WAIT_TERN(0)", "WAIT_TERN(1)" };

static int32_t *ran_low, *ran_high;  /* How many times LOW(k) and HIGH(j) ran in this process */
static int32_t  ran_wait[W_NB];      /* How many times each waiting task ran in this process */
static int32_t  nb_errors = 0;

/* A waiting task starts: the tasks first, first+step, ... of a set that it
 * waits for have run once, as far as this process can tell (the ones that
 * live here). */
static void waited_for(int w, const char *set, const int32_t *ran,
                       int first, int nb, int step, parsec_data_collection_t *dc)
{
    for(int i = first; i < nb; i += step) {
        if( ((int)dc->rank_of(dc, i, 0) == (int)dc->myrank) && (1 != ran[i]) ) {
            fprintf(stderr, "%s starts when %s(%d) has run %d time(s)\n",
                    wait_name[w], set, i, (int)ran[i]);
            (void)parsec_atomic_fetch_inc_int32(&nb_errors);
        }
    }
}

%}

descA      [type = "parsec_matrix_block_cyclic_t*"]
NL         [type = int]
NH         [type = int]

LOW(k)
  k = 0 .. NL-1
: descA(k, 0)

  CTL X -> X WAIT_CST(0)
        -> ((k % 2) == 0) ? X WAIT_IDX(0)
        -> X WAIT_MIX(0)
        -> X WAIT_TERN(0)

BODY
  usleep(1000);  /* Leave a task that starts too early the time to do so */
  (void)parsec_atomic_fetch_inc_int32(&ran_low[k]);
END

HIGH(j)
  j = 0 .. NH-1
: descA(j, 0)

  CTL X -> X WAIT_CST(0)
        -> ((j % 2) == 1) ? X WAIT_IDX(0)
        -> ((j % 2) == 1) ? X WAIT_MIX(0)
        -> (j < NL) ? X WAIT_TERN(1)

BODY
  usleep(1000);
  (void)parsec_atomic_fetch_inc_int32(&ran_high[j]);
END

WAIT_CST(w)
  w = 0 .. 0
: descA(0, 0)

  CTL X <- [ k = 0 .. NL-1 ] 1 ? X LOW(k)
        <- [ j = 0 .. NH-1 ] 1 ? X HIGH(j)

BODY
  waited_for(W_CST, "LOW",  ran_low,  0, NL, 1, &descA->super.super);
  waited_for(W_CST, "HIGH", ran_high, 0, NH, 1, &descA->super.super);
  (void)parsec_atomic_fetch_inc_int32(&ran_wait[W_CST]);
END

WAIT_IDX(w)
  w = 0 .. 0
: descA(1, 0)

  CTL X <- [ k = 0 .. NL-1 ] (k % 2) == 0 ? X LOW(k)
        <- [ j = 0 .. NH-1 ] (j % 2) == 1 ? X HIGH(j)

BODY
  waited_for(W_IDX, "LOW",  ran_low,  0, NL, 2, &descA->super.super);
  waited_for(W_IDX, "HIGH", ran_high, 1, NH, 2, &descA->super.super);
  (void)parsec_atomic_fetch_inc_int32(&ran_wait[W_IDX]);
END

WAIT_MIX(w)
  w = 0 .. 0
: descA(2, 0)

  CTL X <- [ k = 0 .. NL-1 ] 1 ? X LOW(k)
        <- [ j = 0 .. NH-1 ] (j % 2) == 1 ? X HIGH(j)

BODY
  waited_for(W_MIX, "LOW",  ran_low,  0, NL, 1, &descA->super.super);
  waited_for(W_MIX, "HIGH", ran_high, 1, NH, 2, &descA->super.super);
  (void)parsec_atomic_fetch_inc_int32(&ran_wait[W_MIX]);
END

WAIT_TERN(w)
  w = 0 .. 1
: descA(3 + w, 0)

  CTL X <- [ k = 0 .. NL-1 ] (w == 0) ? X LOW(k) : X HIGH(k)

BODY
  if( 0 == w )
    waited_for(W_TERN, "LOW", ran_low, 0, NL, 1, &descA->super.super);
  else
    waited_for(W_TERN + 1, "HIGH", ran_high, 0, NL, 1, &descA->super.super);
  (void)parsec_atomic_fetch_inc_int32(&ran_wait[W_TERN + w]);
END

extern "C" %{

#define LOW_PER_PROCESS 8

int main(int argc, char *argv[])
{
    parsec_context_t *parsec;
    parsec_ctl_gather_ranges_taskpool_t *tp;
    parsec_matrix_block_cyclic_t descA;
    int32_t *total, local[1 + W_NB], global[1 + W_NB];
    int rc, rank, world, NL, NH, ret = 0;

    rc = parsec_tests_context_init(-1, PARSEC_TEST_THREAD_SERIALIZED,
                                   &argc, &argv, &parsec, &rank, &world);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_init");

    /* Tile (i, 0), LOW(i) and HIGH(i) live on process i modulo the number of
     * processes: both sets reach every process. The second set is the larger,
     * so that the wrong counts of two ranged dependencies are too small and
     * the test fails. The one of a ternary is too large: the waiting task
     * never runs, and the time limit of the test ends it. */
    NL = LOW_PER_PROCESS * world;
    NH = 3 * NL;
    parsec_matrix_block_cyclic_init(&descA, PARSEC_MATRIX_INTEGER, PARSEC_MATRIX_TILE,
                                    rank,
                                    1, 1,        /* Tile size */
                                    NH, 1,       /* Global matrix size */
                                    0, 0,        /* Starting point in the global matrix */
                                    NH, 1,       /* Submatrix size */
                                    world, 1,    /* process grid */
                                    1, 1,        /* k-cyclicity */
                                    0, 0);
    descA.mat = parsec_data_allocate(descA.super.nb_local_tiles *
                                     descA.super.bsiz *
                                     parsec_datadist_getsizeoftype(PARSEC_MATRIX_INTEGER));
    parsec_data_collection_set_key(&descA.super.super, "A");

    ran_low  = (int32_t*)calloc(NL + NH, sizeof(int32_t));
    ran_high = ran_low + NL;
    total    = (int32_t*)calloc(NL + NH, sizeof(int32_t));

    tp = parsec_ctl_gather_ranges_new(&descA, NL, NH);
    rc = parsec_context_add_taskpool(parsec, (parsec_taskpool_t*)tp);
    PARSEC_CHECK_ERROR(rc, "parsec_context_add_taskpool");
    rc = parsec_context_start(parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_context_start");
    rc = parsec_context_wait(parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_context_wait");

    rc = parsec_tests_allreduce(parsec, ran_low, total, NL + NH,
                                parsec_datatype_int32_t, PARSEC_TESTS_REDUCE_SUM);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_allreduce");
    local[0] = nb_errors;
    for(int w = 0; w < W_NB; w++) local[1 + w] = ran_wait[w];
    rc = parsec_tests_allreduce(parsec, local, global, 1 + W_NB,
                                parsec_datatype_int32_t, PARSEC_TESTS_REDUCE_SUM);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_allreduce");

    if( 0 == rank ) {
        for(int i = 0; i < NL + NH; i++) {
            if( 1 != total[i] ) {
                fprintf(stderr, "%s(%d) ran %d time(s) instead of once\n",
                        (i < NL) ? "LOW" : "HIGH", (i < NL) ? i : i - NL, (int)total[i]);
                ret = 1;
            }
        }
        for(int w = 0; w < W_NB; w++) {
            if( 1 != global[1 + w] ) {
                fprintf(stderr, "%s ran %d time(s) instead of once\n",
                        wait_name[w], (int)global[1 + w]);
                ret = 1;
            }
        }
        if( 0 != global[0] ) {
            fprintf(stderr, "%d task(s) had not run once when a task that waits for them started\n",
                    (int)global[0]);
            ret = 1;
        }
        if( 0 == ret ) {
            printf("Each waiting task ran once, after the tasks of the two ranges (%d and %d)\n",
                   NL, NH);
        }
    }

    parsec_taskpool_free((parsec_taskpool_t*)tp);
    free(ran_low);
    free(total);
    parsec_data_free(descA.mat);
    parsec_tiled_matrix_destroy((parsec_tiled_matrix_t*)&descA);

    rc = parsec_tests_context_fini(&parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_fini");
    return ret;
}

%}
